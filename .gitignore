# Dependencies
node_modules/

# Build output
dist/
.vite/

# TypeScript composite build artifacts. vite.config.js in particular must never
# be committed: Vite resolves vite.config.js before vite.config.ts and would
# silently shadow the real config.
*.tsbuildinfo
apps/*/vite.config.js
apps/*/vite.config.d.ts

# Env files — never commit secrets
.env
.env.*
!.env.example
!.env.production.example

# Logs
*.log

# Debug artifacts
.playwright-mcp/
/aeo-*.png

# Grader runtime data (rendered reports, in-memory job artifacts)
.aeo-data/
.hpx-data/

# OS
.DS_Store
*.tar.gz
*.zip
