# Frontend env (VITE_ prefix is required for client-side exposure)
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------------------------------------------------------------------------
# aeo-api backend (server/) — Phase 1 plumbing
# ---------------------------------------------------------------------------

# API server port (the Vite dev server proxies /api here)
AEO_API_PORT=3334

# Pipeline mode
#   true  -> mock pipeline: no LLM calls, no cost, canned report (verify plumbing)
#   false -> real pipeline: runs @gms/llm against the 4 engines
AEO_MOCK_PIPELINE=true

# Real-pipeline cost cap: queries run per analysis (each runs against 4 engines)
AEO_MAX_QUERIES=6

# Where rendered HTML reports are written (defaults to ./.aeo-data)
# AEO_DATA_ROOT=

# LLM keys (only needed when AEO_MOCK_PIPELINE=false)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
PERPLEXITY_API_KEY=pplx-...

# Optional model overrides (see @gms/llm config defaults)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Email delivery (Resend SMTP gateway). If SMTP_HOST is unset the email step is
# skipped; the report is still written to disk and served at /api/analyses/:id/report.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=AEO Auditor <audits@growthmarketingstudios.com>

# Legacy (edge-function era, unused by the Phase 1 Express backend)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# RESEND_API_KEY=re_...
