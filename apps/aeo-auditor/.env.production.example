# AEO Visibility Auditor — production environment template (Hostinger Node.js).
# Copy to .env on the server and fill in real values. Never commit the filled file.

NODE_ENV=production

# Hostinger assigns PORT automatically. Leave as a fallback for local prod runs.
PORT=3334

# Pipeline mode. false = real @gms/llm run. true = mock (no LLM calls, no cost).
AEO_MOCK_PIPELINE=false

# Perplexity is opt-in. Set to true only with a valid PERPLEXITY_API_KEY.
ENABLE_PERPLEXITY=false

# ── LLM engine API keys ──────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Email delivery (Resend) ──────────────────────────────────
RESEND_API_KEY=
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=noreply@digitalmedia305.com
SMTP_FROM_NAME=Growth Marketing Studios
SMTP_REPLY_TO=ferminfleites@gmail.com
LEAD_NOTIFICATION_EMAIL=ferminfleites@gmail.com
